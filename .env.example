# ─── Shared environment (root) — used by docker-compose ───
POSTGRES_USER=petpro
POSTGRES_PASSWORD=petpro_dev_password
POSTGRES_DB=petpro
POSTGRES_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5500

# Override in production
JWT_SECRET=change_me_in_production
