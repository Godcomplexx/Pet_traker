# ─── Backend environment ───
ENV=development

# Async SQLAlchemy URL (matches docker-compose)
DATABASE_URL=postgresql+asyncpg://petpro:petpro_dev_password@localhost:5433/petpro

# Redis (Taskiq broker)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (origins allowed to call the API from the browser)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ─── Подтверждение email ───
# Требовать подтверждение email кодом перед входом.
REQUIRE_EMAIL_VERIFICATION=true
VERIFICATION_CODE_TTL_MINUTES=15

# SMTP. Если SMTP_HOST пуст — письма НЕ отправляются (dev-режим): код пишется
# в логи backend и возвращается на экран. Заполните для реальной отправки писем.
# Пример для Gmail (нужен app-password, требует включённой 2FA):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<app-password из https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=PetPro <noreply@petpro.app>
